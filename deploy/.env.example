# 수동 구성(compose)용. 보통은 deploy/install.sh 의 설치 마법사를 쓴다.
# deploy/.env 로 복사해서 값을 채운다. (이 파일은 git 에 올리지 않는다)
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# DB 비밀번호. URL 에 들어가므로 영문·숫자만 쓴다: openssl rand -hex 24
POSTGRES_PASSWORD=

# 첨부 파일 서명 키: openssl rand -hex 32
FILE_URL_SECRET=

# DB 에 저장하는 AI API 키를 암호화하는 키: openssl rand -hex 32  (잃으면 API 키를 어드민에서 다시 입력)
NOTY_SECRET_KEY=

# 첫 관리자(admin) 비밀번호. 비워 두면 무작위로 만들어 api 로그에 한 번 보여 준다.
#   docker compose -f deploy/docker-compose.yml logs api | grep setup
NOTY_ADMIN_PASSWORD=

# 브라우저 접속 주소 (CORS 허용). 예: https://noty.example.com
# Electron 앱(file://)은 따로 허용된다.
CORS_ALLOWED_ORIGINS=

# Ollama 주소. 같은 서버면 loopback 그대로, 다른 GPU 서버면 그 주소(VPN 주소 가능).
# 처음 시작 때의 기본값이고, 이후에는 어드민 → AI 모델에서 바꾼다.
OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=qwen3:8b
# AI_BACKGROUND_MODEL=qwen3:8b
# EMBEDDING_MODEL=bge-m3

# 웹/API 를 열 주소: 127.0.0.1(리버스 프록시·VPN) 또는 0.0.0.0(같은 네트워크에서 바로 접속)
# NOTY_BIND_HOST=127.0.0.1
# 포트. 서버의 다른 서비스와 겹치면 바꾼다.
# NOTY_ADMIN_PORT=4010
# NOTY_API_PORT=4000
# NOTY_COLLAB_PORT=4001
# NOTY_DB_PORT=5433
