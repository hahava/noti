{
  "name": "@noty/desktop",
  "version": "1.4.0",
  "private": true,
  "description": "Noty 데스크톱 앱 (Electron). 빌드된 웹 화면을 불러와 Noty 서버에 접속한다.",
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "author": "Noty",
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "dev.kalin.noty",
    "productName": "Noty",
    "files": [
      "main.cjs",
      "preload.cjs",
      "csp.cjs",
      "LICENSE",
      "build/icon.png",
      "renderer/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "../../release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "copyright": "Copyright © Noty contributors · GPL-3.0",
    "icon": "build/icon.png"
  }
}
