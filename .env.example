# Node API / collaboration server
DATABASE_URL=postgresql://notion:notion@127.0.0.1:5434/notion_like
COLLAB_MODE=single
COLLAB_HOST=127.0.0.1
COLLAB_PORT=4001
COLLAB_INSTANCE_NAME=noty-collab-local

# Set COLLAB_MODE=distributed and share this URL across all collaboration replicas.
# REDIS_URL=redis://127.0.0.1:6380
COLLAB_REDIS_PREFIX=noty:collaboration

# Vite build-time frontend settings
VITE_COLLABORATION_ENABLED=true
# 기본값은 <서버 주소>/collab (API 가 협업 서버로 전달). 다른 주소를 쓸 때만 지정
# VITE_COLLABORATION_URL=ws://127.0.0.1:4000/collab
